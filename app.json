{
  "expo": {
    "name": "Aquascape Studio",
    "slug": "aquascape-studio",
    "scheme": "aquascape",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1F18",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studio.aquascape.app"
    },
    "android": {
      "package": "studio.aquascape.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A1F18"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
